# Phase 3: USDA FoodData Central search (free key from https://fdc.nal.usda.gov/api-key-signup)
USDA_API_KEY=
# Phase 4: optional Supabase sync (leave empty to stay local-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Phase 4: background reminders via web push (docs/PUSH.md). Leave empty to keep in-app reminders only.
# VAPID keys, raw base64url (generate with the node one-liner in docs/PUSH.md)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=
# Server only: Supabase service_role key (push_jobs / push_subscriptions are service-role only)
SUPABASE_SERVICE_ROLE_KEY=
# Bearer secret the every-minute cron sends to /api/push/dispatch
PUSH_CRON_SECRET=
